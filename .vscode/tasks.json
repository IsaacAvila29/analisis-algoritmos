{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: archivo actual",
            "type": "shell",
            "command": "make",
            "args": ["build", "FILE=${relativeFile}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "run: archivo actual",
            "type": "shell",
            "command": "make",
            "args": ["run", "FILE=${relativeFile}"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "clear": true, "focus": true }
        },
        {
            "label": "release: archivo actual (-O2)",
            "type": "shell",
            "command": "make",
            "args": ["release", "FILE=${relativeFile}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "clear": true, "focus": true }
        },
        {
            "label": "debug: archivo actual (sanitizers)",
            "type": "shell",
            "command": "make",
            "args": ["debug", "FILE=${relativeFile}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "clear": true, "focus": true }
        }
    ]
}
